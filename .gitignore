# Supplied data: read-only, never tracked.
# Integrity is proven by the fingerprint in artifacts/manifests/ (step 0.2).
data/

# Third-party papers: reference only, not ours to redistribute.
paper/

# Large regenerable outputs. Keep only the small manifests (splits, checksums).
artifacts/*
!artifacts/manifests/

# Python and the project venv (step 0.3)
.venv/
__pycache__/
*.pyc

# macOS Finder files
.DS_Store

# Build metadata from `pip install -e .`
*.egg-info/

# Claude Code personal settings (guide-only permissions), per the Claude Code docs
.claude/settings.local.json
Claude outputs/


# Local working notes, kept on disk but not submitted: design log, planning docs, per-phase reports, slide drafts.
# The submitted talk is submission/slides.pdf.
docs/
CLAUDE.md
slides/
results/*/report.md
results/slide_log.md